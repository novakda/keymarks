{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Powermarks",
  "version": "0.1.0",
  "identifier": "com.xhiris.powermarks",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Powermarks", "width": 960, "height": 680 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.ico"] }
}
