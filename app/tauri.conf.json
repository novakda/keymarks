{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keymarks",
  "version": "0.1.0",
  "identifier": "com.pattern158.keymarks",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Keymarks", "width": 1320, "height": 820, "minWidth": 900, "minHeight": 500, "visible": false }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.ico"] }
}
