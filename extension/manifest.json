{
  "manifest_version": 3,
  "name": "Powermarks",
  "version": "0.1.0",
  "description": "Add the current page to Powermarks with keywords.",
  "key": "",
  "action": { "default_popup": "popup.html", "default_title": "Add to Powermarks" },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+P" } } },
  "permissions": ["nativeMessaging", "activeTab", "scripting"],
  "icons": { "128": "icon.png" },
  "browser_specific_settings": { "gecko": { "id": "powermarks@xhiris" } }
}
